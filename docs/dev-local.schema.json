{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Exoridus/fahrenheit-parry-mod/docs/dev-local.schema.json",
  "title": "Local Developer Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "GameDir": {
      "type": "string",
      "description": "Absolute path to game install directory containing FFX.exe."
    },
    "AutoDeploy": {
      "type": ["boolean", "null"],
      "description": "Enable automatic post-build deploy in local build workflow. Null means not configured yet."
    },
    "DeployBlocklist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths to skip while deploying. Supports both relative paths under GameDir\\fahrenheit and absolute filesystem paths."
    }
  },
  "required": ["GameDir", "AutoDeploy", "DeployBlocklist"],
  "examples": [
    {
      "GameDir": "C:\\Games\\Final Fantasy X-X2 - HD Remaster",
      "AutoDeploy": null,
      "DeployBlocklist": [
        "mods/loadorder",
        "saves",
        "C:\\Games\\Final Fantasy X-X2 - HD Remaster\\fahrenheit\\mods\\some_other_mod"
      ]
    }
  ]
}

