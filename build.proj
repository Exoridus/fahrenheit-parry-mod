<Project DefaultTargets="Help">
    <PropertyGroup>
        <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</RepoRoot>
        <FahrenheitRepo Condition="'$(FahrenheitRepo)' == ''">https://github.com/peppy-enterprises/fahrenheit.git</FahrenheitRepo>
        <FahrenheitDir Condition="'$(FahrenheitDir)' == ''">$([MSBuild]::NormalizeDirectory('$(RepoRoot)', '.workspace', 'fahrenheit'))</FahrenheitDir>
        <!-- Pin to the committed ref (fahrenheit.release.ref) by default so a plain build is
             deterministic and does NOT silently drift to origin/main (which is currently the
             in-flight alpha11 line). Explicit -p:FahrenheitRef=... still overrides. -->
        <FahrenheitRef Condition="'$(FahrenheitRef)' == '' and Exists('$(RepoRoot)fahrenheit.release.ref')">$([System.IO.File]::ReadAllText('$(RepoRoot)fahrenheit.release.ref').Trim())</FahrenheitRef>
        <FahrenheitRef Condition="'$(FahrenheitRef)' == ''">origin/main</FahrenheitRef>
        <FahrenheitDirPath>$([System.Text.RegularExpressions.Regex]::Replace('$([MSBuild]::NormalizePath('$(FahrenheitDir)'))', '[\\/]+$$', ''))</FahrenheitDirPath>
        <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
        <ModId Condition="'$(ModId)' == ''">fhparry</ModId>

        <ModProjectPath Condition="'$(ModProjectPath)' == ''">$([MSBuild]::NormalizePath('$(RepoRoot)', 'Fahrenheit.Mods.Parry.csproj'))</ModProjectPath>

        <!-- Default to upstream layout post-fahrenheit#134 ("rearrange source tree"). The
             ResolveFahrenheitProjects target falls back to the pre-#134 layout if the
             checked-out fahrenheit ref still uses it. Callers may override via -p:. -->
        <ManagedCoreProject Condition="'$(ManagedCoreProject)' == ''">$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'src', 'core', 'Fahrenheit.csproj'))</ManagedCoreProject>
        <ManagedRuntimeProject Condition="'$(ManagedRuntimeProject)' == ''">$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'src', 'runtime', 'Fahrenheit.Runtime.csproj'))</ManagedRuntimeProject>
        <FahrenheitSdkProject Condition="'$(FahrenheitSdkProject)' == ''">$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'src', 'sdk', 'Fahrenheit.Sdk.csproj'))</FahrenheitSdkProject>

        <!-- Local NuGet feed Fahrenheit's build writes its packages to; see NuGet.config. -->
        <FahrenheitPkgDirRel>$([MSBuild]::NormalizeDirectory('$(FahrenheitDir)', 'artifacts', 'pkg', 'rel'))</FahrenheitPkgDirRel>
        <FahrenheitPkgDirDbg>$([MSBuild]::NormalizeDirectory('$(FahrenheitDir)', 'artifacts', 'pkg', 'dbg'))</FahrenheitPkgDirDbg>
        <Stage0Project Condition="'$(Stage0Project)' == ''">$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'src', 'stage0', 'Fahrenheit.Loader.Stage0.vcxproj'))</Stage0Project>
        <Stage1Project Condition="'$(Stage1Project)' == ''">$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'src', 'stage1', 'Fahrenheit.Loader.Stage1.vcxproj'))</Stage1Project>

        <_LegacyManagedCoreProject>$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'core', 'fh', 'Fahrenheit.csproj'))</_LegacyManagedCoreProject>
        <_LegacyManagedRuntimeProject>$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'core', 'runtime', 'Fahrenheit.Runtime.csproj'))</_LegacyManagedRuntimeProject>
        <_LegacyStage0Project>$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'core', 'stage0', 'Fahrenheit.Loader.Stage0.vcxproj'))</_LegacyStage0Project>
        <_LegacyStage1Project>$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'core', 'stage1', 'Fahrenheit.Loader.Stage1.vcxproj'))</_LegacyStage1Project>

        <DeployConfigFolder Condition="'$(Configuration)' == 'Debug'">dbg</DeployConfigFolder>
        <DeployConfigFolder Condition="'$(DeployConfigFolder)' == ''">rel</DeployConfigFolder>
        <DeployDir>$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'artifacts', 'deploy', '$(DeployConfigFolder)'))</DeployDir>
        <DeployModsDir>$([MSBuild]::NormalizePath('$(DeployDir)', 'mods'))</DeployModsDir>
        <DeployModDir>$([MSBuild]::NormalizePath('$(DeployModsDir)', '$(ModId)'))/</DeployModDir>
        <LoadOrderPath>$([MSBuild]::NormalizePath('$(DeployModsDir)', 'loadorder'))</LoadOrderPath>

        <ModBaseOutputPath>$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'artifacts', 'build', 'Fahrenheit.Mods.Parry'))/</ModBaseOutputPath>
        <ModBaseIntermediateOutputPath>$([MSBuild]::NormalizePath('$(FahrenheitDir)', 'artifacts', 'obj', 'Fahrenheit.Mods.Parry'))/</ModBaseIntermediateOutputPath>
        <SolutionDirForBuild>$(FahrenheitDirPath)/</SolutionDirForBuild>

        <FahrenheitGitDir>$([MSBuild]::NormalizePath('$(FahrenheitDirPath)', '.git'))</FahrenheitGitDir>
        <FahrenheitParentDir>$([MSBuild]::NormalizeDirectory('$(FahrenheitDirPath)', '..'))</FahrenheitParentDir>
        <ProgramFilesX86>$([System.Environment]::GetEnvironmentVariable('ProgramFiles(x86)'))</ProgramFilesX86>
        <VsWhereExe>$([MSBuild]::NormalizePath('$(ProgramFilesX86)', 'Microsoft Visual Studio', 'Installer', 'vswhere.exe'))</VsWhereExe>

        <NativeMSBuildExe Condition="'$(NativeMSBuildExe)' == '' and '$(OS)' == 'Windows_NT'">msbuild</NativeMSBuildExe>
        <NativePlatformToolset Condition="'$(NativePlatformToolset)' == ''"></NativePlatformToolset>
        <NativePlatformToolsetArg Condition="'$(NativePlatformToolset)' != ''"> /p:PlatformToolset=$(NativePlatformToolset)</NativePlatformToolsetArg>
    </PropertyGroup>

    <Target Name="Help">
        <Message Importance="high" Text="Targets:" />
        <Message Importance="high" Text="  dotnet msbuild build.proj -t:Setup [-p:FahrenheitDir=...] [-p:FahrenheitRepo=...]" />
        <Message Importance="high" Text="  dotnet msbuild build.proj -t:BuildModOnly [-p:Configuration=Release|Debug]" />
        <Message Importance="high" Text="  dotnet msbuild build.proj -t:Build [-p:Configuration=Release|Debug] [-p:NativeMSBuildExe=...] [-p:NativePlatformToolset=v143]" />
        <Message Importance="high" Text="  dotnet msbuild build.proj -t:Deploy (alias of Build)" />
    </Target>

    <Target Name="ValidateInputs">
        <Error Condition="!Exists('$(ModProjectPath)')" Text="Mod project not found: $(ModProjectPath)" />
    </Target>

    <Target Name="RequireGit" DependsOnTargets="ValidateInputs">
        <Exec Command="git --version" />
    </Target>

    <Target Name="EnsureFahrenheitCheckout" DependsOnTargets="RequireGit">
        <MakeDir Directories="$(FahrenheitParentDir)" />

        <Exec Condition="!Exists('$(FahrenheitGitDir)')"
              Command="git clone --recurse-submodules &quot;$(FahrenheitRepo)&quot; &quot;$(FahrenheitDirPath)&quot;" />

        <Exec Condition="Exists('$(FahrenheitGitDir)')"
              Command="git -C &quot;$(FahrenheitDirPath)&quot; fetch --all --tags" />
        <Exec Condition="Exists('$(FahrenheitGitDir)')"
              Command="git -C &quot;$(FahrenheitDirPath)&quot; -c advice.detachedHead=false checkout --force &quot;$(FahrenheitRef)&quot;" />
        <Exec Condition="Exists('$(FahrenheitGitDir)')"
              Command="git -C &quot;$(FahrenheitDirPath)&quot; submodule sync --recursive" />
        <Exec Condition="Exists('$(FahrenheitGitDir)')"
              Command="git -C &quot;$(FahrenheitDirPath)&quot; submodule update --init --recursive" />

        <Message Importance="high" Text="Fahrenheit ref: $(FahrenheitRef)" />
    </Target>

    <Target Name="ResolveFahrenheitProjects" DependsOnTargets="EnsureFahrenheitCheckout">
        <PropertyGroup>
            <ManagedCoreProject Condition="!Exists('$(ManagedCoreProject)') and Exists('$(_LegacyManagedCoreProject)')">$(_LegacyManagedCoreProject)</ManagedCoreProject>
            <ManagedRuntimeProject Condition="!Exists('$(ManagedRuntimeProject)') and Exists('$(_LegacyManagedRuntimeProject)')">$(_LegacyManagedRuntimeProject)</ManagedRuntimeProject>
            <Stage0Project Condition="!Exists('$(Stage0Project)') and Exists('$(_LegacyStage0Project)')">$(_LegacyStage0Project)</Stage0Project>
            <Stage1Project Condition="!Exists('$(Stage1Project)') and Exists('$(_LegacyStage1Project)')">$(_LegacyStage1Project)</Stage1Project>
        </PropertyGroup>

        <ItemGroup Condition="!Exists('$(ManagedCoreProject)')">
            <_FoundManagedCoreProject Include="$(FahrenheitDirPath)/**/Fahrenheit.csproj" />
        </ItemGroup>
        <PropertyGroup Condition="!Exists('$(ManagedCoreProject)') and '@(_FoundManagedCoreProject->Count())' == '1'">
            <ManagedCoreProject>@(_FoundManagedCoreProject->'%(FullPath)')</ManagedCoreProject>
        </PropertyGroup>

        <Error Condition="!Exists('$(ManagedCoreProject)')"
               Text="Missing Fahrenheit core project. Searched (in order): $(ManagedCoreProject); $(_LegacyManagedCoreProject); recursive scan under '$(FahrenheitDirPath)' (matches: '@(_FoundManagedCoreProject)'). Pass -p:ManagedCoreProject=&lt;path&gt; to override." />
        <Error Condition="!Exists('$(ManagedRuntimeProject)')"
               Text="Missing Fahrenheit runtime project. Searched: $(ManagedRuntimeProject); $(_LegacyManagedRuntimeProject). Pass -p:ManagedRuntimeProject=&lt;path&gt; to override." />

        <Message Importance="low" Text="Resolved Fahrenheit core: $(ManagedCoreProject)" />
        <Message Importance="low" Text="Resolved Fahrenheit runtime: $(ManagedRuntimeProject)" />
    </Target>

    <Target Name="RestoreManagedProjects" DependsOnTargets="ResolveFahrenheitProjects">
        <Error Condition="!Exists('$(ManagedCoreProject)')" Text="Missing Fahrenheit core project: $(ManagedCoreProject)" />
        <Error Condition="!Exists('$(ManagedRuntimeProject)')" Text="Missing Fahrenheit runtime project: $(ManagedRuntimeProject)" />

        <!-- Restore runs as its own process, not via the MSBuild task.
             Fahrenheit's core pulls CsWin32, a source generator delivered as an
             analyzer package. An <MSBuild Targets="Restore"> call restores into the
             same MSBuild instance that later evaluates the project for Build, and
             that evaluation is already cached from before project.assets.json
             existed — so the analyzer is not loaded, the generator never runs, and
             the checked-in Windows.Win32.*.g.cs files fail with CS0234/CS0246.
             Only reproducible from a clean tree: a warm one has the assets from a
             previous run, which is why this passed locally and failed in CI. -->
        <!-- Every restore below reads this repo's NuGet.config, which configures the
             two local feeds the pack step later fills. NuGet fails a restore outright
             with NU1301 when a configured local source does not exist, and on a clean
             clone neither folder does yet. Create both up front: a warm tree has them
             from a previous run, which is exactly why this passed locally and failed
             in CI. -->
        <MakeDir Directories="$(FahrenheitPkgDirRel);$(FahrenheitPkgDirDbg)" />

        <Exec Command="dotnet restore &quot;$(ManagedCoreProject)&quot; -p:Configuration=$(Configuration) -p:SolutionDir=&quot;$(SolutionDirForBuild)&quot;" />
        <Exec Command="dotnet restore &quot;$(ManagedRuntimeProject)&quot; -p:Configuration=$(Configuration) -p:SolutionDir=&quot;$(SolutionDirForBuild)&quot;" />
        <Exec Command="dotnet restore &quot;$(FahrenheitSdkProject)&quot; -p:Configuration=$(Configuration) -p:SolutionDir=&quot;$(SolutionDirForBuild)&quot;" />
    </Target>

    <!-- The mod consumes Fahrenheit as a NuGet package via Fahrenheit.Sdk, so both
         packages must exist in the local feed (artifacts/pkg/<cfg>) before the mod
         project can be restored. MSBuild resolves an SDK during evaluation, which
         happens before any target runs, so this cannot be folded into the mod build:
         Fahrenheit has to be packed in a separate, earlier step. -->
    <Target Name="PackFahrenheit" DependsOnTargets="RestoreManagedProjects">
        <MSBuild Projects="$(ManagedCoreProject);$(ManagedRuntimeProject);$(FahrenheitSdkProject)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);SolutionDir=$(SolutionDirForBuild)" />
    </Target>

    <Target Name="RestoreModProject" DependsOnTargets="PackFahrenheit">
        <!-- NuGet fails with NU1301 if a configured local source is missing, and only
             the folder for the configuration just built exists. Create both so a
             Release build does not trip over the absent Debug feed and vice versa. -->
        <MakeDir Directories="$(FahrenheitPkgDirRel);$(FahrenheitPkgDirDbg)" />
        <Exec Command="dotnet restore &quot;$(ModProjectPath)&quot; -p:Configuration=$(Configuration) -p:SolutionDir=&quot;$(SolutionDirForBuild)&quot;" />
    </Target>

    <Target Name="Setup" DependsOnTargets="RestoreModProject">
        <Message Importance="high" Text="Setup complete. Workspace: $(FahrenheitDirPath)" />
    </Target>

    <Target Name="ResolveNativeMSBuild" Condition="'$(OS)' == 'Windows_NT'">
        <Exec Condition="'$(NativeMSBuildExe)' == 'msbuild' and Exists('$(VsWhereExe)')"
              Command="&quot;$(VsWhereExe)&quot; -latest -products * -requires Microsoft.Component.MSBuild -property installationPath"
              ConsoleToMSBuild="true"
              StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" ItemName="_VsWhereInstallPath" />
        </Exec>

        <PropertyGroup Condition="'$(NativeMSBuildExe)' == 'msbuild' and '@(_VsWhereInstallPath)' != ''">
            <NativeMSBuildExe>@(_VsWhereInstallPath->'%(Identity)\MSBuild\Current\Bin\MSBuild.exe')</NativeMSBuildExe>
        </PropertyGroup>

        <Exec Command="&quot;$(NativeMSBuildExe)&quot; -version -nologo"
              IgnoreExitCode="true"
              StandardOutputImportance="low">
            <Output TaskParameter="ExitCode" PropertyName="_NativeMsbuildFinalProbeExitCode" />
        </Exec>

        <Error Condition="'$(_NativeMsbuildFinalProbeExitCode)' != '0'"
               Text="Could not find a usable MSBuild.exe. Install Visual Studio Build Tools with C++ workload, or pass -p:NativeMSBuildExe=&lt;path-to-MSBuild.exe&gt;." />
    </Target>

    <Target Name="BuildNativeLoaders" DependsOnTargets="ResolveNativeMSBuild;ResolveFahrenheitProjects">
        <Error Condition="'$(OS)' != 'Windows_NT'" Text="Full build is only supported on Windows (stage0/stage1 are native VC++ projects)." />
        <Error Condition="!Exists('$(Stage0Project)')" Text="Missing Stage0 project: $(Stage0Project)" />
        <Error Condition="!Exists('$(Stage1Project)')" Text="Missing Stage1 project: $(Stage1Project)" />

        <Message Importance="high" Condition="'$(NativePlatformToolset)' != ''" Text="Using native platform toolset override: $(NativePlatformToolset)" />
        <Exec Command="&quot;$(NativeMSBuildExe)&quot; &quot;$(Stage0Project)&quot; /p:Configuration=$(Configuration) /p:Platform=Win32$(NativePlatformToolsetArg)" />
        <Exec Command="&quot;$(NativeMSBuildExe)&quot; &quot;$(Stage1Project)&quot; /p:Configuration=$(Configuration) /p:Platform=Win32$(NativePlatformToolsetArg)" />
    </Target>

    <!-- Fahrenheit's managed components are built (and, through their own
         __FhPublishAfterBuild hook, published) by PackFahrenheit. Only the mod is
         left here.

         The mod is built, not published: Fahrenheit.Sdk carries the same
         __FhPublishAfterBuild hook, so asking for Publish closes the target graph
         into a cycle (MSB4006). PublishDir is passed as a property so the SDK's own
         hook lands the output in the deploy tree. -->
    <Target Name="PublishManagedComponents" DependsOnTargets="PackFahrenheit">
        <MSBuild Projects="$(ModProjectPath)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);SolutionDir=$(SolutionDirForBuild);PublishDir=$(DeployModDir);BuildProjectReferences=false" />
    </Target>

    <Target Name="WriteLoadOrder">
        <MakeDir Directories="$(DeployModsDir)" />
        <ReadLinesFromFile File="$(LoadOrderPath)" Condition="Exists('$(LoadOrderPath)')">
            <Output TaskParameter="Lines" ItemName="_LoadOrderExisting" />
        </ReadLinesFromFile>

        <ItemGroup>
            <_LoadOrderFiltered Include="@(_LoadOrderExisting)"
                                Condition="'%(Identity)' != '' and '%(Identity)' != 'fhruntime' and '%(Identity)' != '$(ModId)'" />
            <_LoadOrderFiltered Include="$(ModId)" />
        </ItemGroup>

        <RemoveDuplicates Inputs="@(_LoadOrderFiltered)">
            <Output TaskParameter="Filtered" ItemName="_LoadOrderFinal" />
        </RemoveDuplicates>

        <WriteLinesToFile File="$(LoadOrderPath)"
                          Lines="@(_LoadOrderFinal)"
                          Overwrite="true"
                          Encoding="UTF-8" />
    </Target>

    <Target Name="BuildModOnly" DependsOnTargets="Setup;PublishManagedComponents;WriteLoadOrder">
        <Message Importance="high" Text="BuildModOnly complete. Deploy output: $(DeployDir)" />
    </Target>

    <Target Name="Build" DependsOnTargets="Setup;BuildNativeLoaders;PublishManagedComponents;WriteLoadOrder">
        <Message Importance="high" Text="Build complete. Deploy output: $(DeployDir)" />
    </Target>

    <Target Name="Deploy" DependsOnTargets="Build" />
</Project>

