<!--
Welcome to an example .csproj file for a Fahrenheit module!

The Fahrenheit SDK supplies everything a compliant mod needs: target framework,
x86 runtime identifier, dynamic loading, the reference to Fahrenheit's core
library, and the conventions for the manifest, lang/, efl/ and resources/.
See its Sdk.props for what that covers; do not repeat any of it here.

The SDK is resolved from NuGet. Until the alpha11 packages are on nuget.org they
come from the local feed in NuGet.config, which Fahrenheit's own build fills.
That means Fahrenheit must have been built once before this project can even be
evaluated; 'build.cmd setup' does exactly that.
-->
<Project Sdk="Fahrenheit.Sdk/1.0.0-alpha11">

    <!-- ASSEMBLY ADDITIONAL PROPERTIES -->
    <!--
    These properties are unique to your own mod!

    AssemblyName is the name of the finished module DLL, ex. `fhparry.dll`.
    AssemblyTitle and Product appear when hovering over the DLL in Windows Explorer.
    -->
    <!--
    These feed the manifest the SDK generates after publish (__FhEmitManifest in
    its Sdk.targets), which is why they are the single source of truth for it:
      Id      <- AssemblyName        Name  <- AssemblyTitle
      Desc    <- Description         Authors <- Authors
      Version <- InformationalVersion (derived from Version)
      Link    <- RepositoryUrl       Flags <- FhManifestFlags
    'build.cmd release-bump' rewrites Version and RepositoryUrl here.
    -->
    <PropertyGroup>
        <AssemblyName>fhparry</AssemblyName>
        <AssemblyTitle>Parry Prototype</AssemblyTitle>
        <Product>Parry Prototype</Product>
        <Description>Watches battle cues and lets you parry physical attacks by pressing R1 (or P on keyboard).</Description>
        <Authors>Thomas</Authors>
        <Version>0.4.1</Version>
        <RepositoryUrl>https://github.com/Exoridus/fahrenheit-parry-mod</RepositoryUrl>
        <FhManifestFlags>NONE</FhManifestFlags>
        <!-- Without this the SDK appends '+<commit sha>' to InformationalVersion, and
             that lands verbatim in the manifest's Version field. -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <!-- SHARED FILE LINKS -->
    <!--
    This imports Fahrenheit's code style rules to allow you to write in a uniform way.
    -->
    <ItemGroup>
        <None Include="$(SolutionDir).editorconfig" Link=".editorconfig" Condition="'$(SolutionDir)' != '' and Exists('$(SolutionDir).editorconfig')" />
    </ItemGroup>

    <!-- REPO TOOLING EXCLUDES -->
    <ItemGroup>
        <Compile Remove=".workspace/**" />
        <Compile Remove="build/**" />
        <Compile Remove="tests/**" />
    </ItemGroup>

    <!-- ASSETS: RUNTIME MAPPINGS -->
    <!--
    Mod-specific, and therefore not covered by the SDK's asset conventions.
    -->
    <ItemGroup>
        <None Include="mappings/runtime/*.json" CopyToOutputDirectory="Always" />
    </ItemGroup>

</Project>
