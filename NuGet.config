<?xml version="1.0" encoding="utf-8"?>
<!--
    Fahrenheit is consumed as a NuGet package (Fahrenheit + Fahrenheit.Sdk), not
    compiled from source. Until those packages are published for the alpha11 line,
    they are taken from the local feed that Fahrenheit's own build writes to
    (artifacts/pkg/{rel,dbg}, per its Directory.Build.props PackageOutputPath).

    That feed is filled by 'build.cmd setup', which builds Fahrenheit once. Once the
    packages appear on nuget.org, drop the two FahrenheitLocal entries below; the
    version pinned in Fahrenheit.Mods.Parry.csproj stays as it is.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="FahrenheitLocal" value=".workspace/fahrenheit/artifacts/pkg/rel" />
        <add key="FahrenheitLocalDebug" value=".workspace/fahrenheit/artifacts/pkg/dbg" />
    </packageSources>
</configuration>
