<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CS0649: Nuke [Parameter] fields are assigned via reflection at runtime -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <NukeTelemetryVersion>0</NukeTelemetryVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nuke.Common" Version="10.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <!-- Override vulnerable transitive dependencies from Nuke.Common 10.1.0: -->
    <PackageReference Include="NuGet.Packaging" Version="6.13.1" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.9" />
  </ItemGroup>
</Project>
