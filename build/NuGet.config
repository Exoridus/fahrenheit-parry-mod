<?xml version="1.0" encoding="utf-8"?>
<!--
    The build project is the first thing every build.cmd invocation restores, and it
    needs nothing from the two local Fahrenheit feeds the root NuGet.config lists.
    NuGet fails a restore outright with NU1301 when a listed local source does not
    exist, and on a clean clone (any CI runner without a warm package cache) nothing
    has created those feeds yet, so `build.cmd help` died before the workflow that
    creates them could run. This file clears the inherited sources for the build
    project alone; the mod and the tests keep reading the root file.
-->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
</configuration>
